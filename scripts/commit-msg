#!/bin/sh
# Rejects commit messages that do not start with a ticket ID, e.g. "MTV-014: Add footer newsletter form".
# A ticket ID is the three-letter prefix of a project, a dash and a number.
# Install in a project repo: cp path/to/logbook/scripts/commit-msg .git/hooks/commit-msg
first_line=$(head -n 1 "$1")
case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac
if ! printf '%s' "$first_line" | grep -Eq '^[A-Z]{3}-[0-9]+: .+'; then
  echo "Commit message must start with a ticket ID, e.g. 'MTV-014: Add footer newsletter form'." >&2
  exit 1
fi
