{
  "name": "logbook",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    { "binding": "TICKETS", "bucket_name": "logbook-tickets" }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "PUBLIC_READ": "1",
    "ACCESS_TEAM_DOMAIN": "https://simsab.cloudflareaccess.com",
    "ACCESS_AUD": "fb36bc5103c3a759c45469bb76dd5b628d853223774bff2052dbfbbe28623365"
  }
}
